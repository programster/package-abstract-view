{
    "name": "programster/abstract-view",
    "type": "library",
    "description": "An abstract view to make views easy.",
    "keywords": ["views"],
    "homepage": "https://github.com/programster/package-abstract-view",
    "license": "MIT",
    "authors": [
        {
            "name": "Stuart Page",
            "email": "sdpagent@gamail.com",
            "homepage": "https://blog.programster.org",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Programster\\AbstractView\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Programster\\AbstractView\\Testing\\": "testing/"
        }
    }
}
